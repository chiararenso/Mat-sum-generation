# ============================================================================
# Confidential third-party data (Akkodis) — NEVER commit. Kept out of the repo.
# ============================================================================
data (AKKODIS)/
/output/                # Akkodis pipeline outputs (derived from confidential GPS)
/maps/                  # per-trajectory Folium maps of Akkodis trajectories
/figures/               # local figure dump (Akkodis-mixed); committed figures live in paper/figures/
*.html                  # generated reports may embed confidential data

# ============================================================================
# Large / regenerable data — reproducible from the public sources via the code
# ============================================================================
*.parquet
*.pbf
*.osm
*.zip
*.plt
*.npz
val_paris/output/*.parquet
val_paris/figures/
geolife/                # local GeoLife working dir (public, but large & regenerable)
osm_pbf/

# Allow the small public label maps and the small result CSVs
!data/labeled_OSM_category.csv
!data/pois_categories_OSM.txt

# Committed prepared PUBLIC datasets (needed to run the experiments; all < 100 MB)
!data/paris/*.parquet
!data/geolife/*.parquet
!data/geolife/*.pkl
!data/geolife/*.csv
!data/geolife/*.png
# Beijing OSM extract (BBBike, public); small enough to commit alongside the prepared data
!data/geolife/beijing.osm.pbf
# The two large raw/intermediate GeoLife files are NOT committed (hundreds of MB): they
# regenerate deterministically in a few minutes from beijing.osm.pbf + the public GeoLife
# download via geolife_audit.py -> geolife_points.py -> matsum_prepare.py (see data/README.md)
data/geolife/geolife_points.parquet
data/geolife/trajectories.parquet

# ============================================================================
# Environment / caches / OS junk
# ============================================================================
__pycache__/
*.pyc
*.pyo
.venv/
venv/
matsum-venv/
.DS_Store
.ipynb_checkpoints/
*.log
